# 평가 서버용 값입니다. 채운 뒤 .env.server로 복사합니다.
#   cp .env.server.example .env.server
# .env.server는 커밋하지 않습니다.

POSTGRES_DB=chaltteok
POSTGRES_USER=chaltteok
POSTGRES_PASSWORD=

# HCX_ENABLED=true인데 키가 비어 있으면 앱이 아예 뜨지 않고 계속 재시작합니다.
# 키를 채운 뒤 올리세요. HCX_ENABLED=false면 근거를 찾은 질문이 전부 503입니다.
HCX_ENABLED=true
HCX_API_KEY=

# 주최측이 호출할 포트. 평가 규격은 80입니다.
PUBLIC_PORT=80

LOG_LEVEL=INFO

# 컨테이너 메모리 상한. 2GB 장비 기준이며 합이 장비 메모리를 넘으면 안 됩니다.
APP_MEM_LIMIT=1g
DB_MEM_LIMIT=512m
